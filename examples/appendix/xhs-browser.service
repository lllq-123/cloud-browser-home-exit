[Unit]
Description=Dedicated cloud browser with a persistent profile
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
UMask=0077
ExecStart=%h/.local/bin/xhs-browser
Restart=always
RestartSec=10
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=default.target
