# Copy to ~/.config/xhs-browser/browser.env and edit your own file.
# The default executable is read from ~/.config/xhs-browser/chrome-path.
# XHS_CHROME_BIN=/absolute/path/to/full/chrome

XHS_BROWSER_MODE=headless
XHS_CDP_PORT=9222
XHS_LOAD_EXTENSION=1
XHS_ACCEPT_LANG=zh-CN,zh,en-US,en
XHS_START_URL=about:blank

# native keeps the browser's native UA and Client Hints.
# linux-desktop overrides only the UA string; inspect Client Hints separately.
XHS_UA_MODE=native

# Keep both off normally. Read the troubleshooting section before enabling.
XHS_NO_SANDBOX=0
XHS_SMALL_SHM=0
